{
  "name": "trektribe-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --prefer-ts-exts src/server.ts",
    "dev:build": "tsc --watch -p tsconfig.json",
    "dev:run": "node dist/server.js",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "validator": "^13.15.23",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/validator": "^13.15.10",
    "prisma": "^6.19.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.2"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  }
}
