// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Todo {
  id    Int    @id @default(autoincrement())
  title String
}
model User {
  id           Int             @id @default(autoincrement())
  nombre       String
  apellido     String
  dni          String?          @unique
  email        String          @unique
  telefono     String?
  fechaNacimiento String?
  password     String
  avatarUri    String?
  viajes       MiembroViaje[]
  tareas       Tarea[]         @relation("TareasUsuario")
  gastos       Gasto[]         @relation("GastosUsuario")
  gastosParticipados Gasto[]        @relation("ParticipantesGasto")
  mensajes     ChatMensaje[]
  pagosRealizados  Settlement[] @relation("SettlementsPagador")
  pagosRecibidos   Settlement[] @relation("SettlementsReceptor")
  chatsComoA       Chat[]       @relation("ChatUsuarioA")
  chatsComoB       Chat[]       @relation("ChatUsuarioB")
  mensajesChatPrivado MensajeChatPrivado[]
  creadoAt     DateTime        @default(now())
}

model Viaje {
  id            Int             @id @default(autoincrement())
  nombre        String
  descripcion   String?
  fechaInicio   DateTime?
  fechaFin      DateTime?
  ubicacion     String?
  maxMiembros   Int?
  creadorId     Int?
  imagen        String?
  miembros      MiembroViaje[]
  tareas        Tarea[]
  gastos        Gasto[]
  mensajes      ChatMensaje[]
  itinerario    ItinerarioEvento[]
  settlements   Settlement[]
  creadoEn      DateTime        @default(now())
}

model MiembroViaje {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  viajeId    Int
  rol        String   @default("miembro") // admin, miembro, invitado
  usuario    User  @relation(fields: [usuarioId], references: [id])
  viaje      Viaje    @relation(fields: [viajeId], references: [id])
  // Última vez que este usuario abrió el chat grupal de este viaje. Se usa
  // para calcular el punto de "no leído" (misma lógica que Chat.leidoPorAEn
  // en el chat 1 a 1, pero acá alcanza con un solo campo porque cada fila
  // de MiembroViaje ya es única por usuario+viaje).
  chatLeidoEn DateTime?
}

model Tarea {
  id           Int       @id @default(autoincrement())
  titulo       String
  descripcion  String?
  estado       String    @default("pendiente") // pendiente, completada
  responsableId Int?
  viajeId      Int
  responsable  User?  @relation("TareasUsuario", fields: [responsableId], references: [id])
  viaje        Viaje     @relation(fields: [viajeId], references: [id])
  creadoEn     DateTime  @default(now())
}

model Gasto {
  id           Int       @id @default(autoincrement())
  monto        Float
  categoria    String?
  descripcion  String?
  pagadoPorId  Int
  viajeId      Int
  pagadoPor    User   @relation("GastosUsuario", fields: [pagadoPorId], references: [id])
  viaje        Viaje     @relation(fields: [viajeId], references: [id])
  participantes User[]   @relation("ParticipantesGasto")
  creadoEn     DateTime  @default(now())
}

model ChatMensaje {
  id        Int      @id @default(autoincrement())
  contenido String
  usuarioId Int
  viajeId   Int
  usuario   User  @relation(fields: [usuarioId], references: [id])
  viaje     Viaje    @relation(fields: [viajeId], references: [id])
  enviadoEn DateTime @default(now())
}

model ItinerarioEvento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  ubicacion   String?
  fechaHora   DateTime
  viajeId     Int
  viaje       Viaje    @relation(fields: [viajeId], references: [id])
}

// Registra un pago que salda (total o parcialmente) una deuda entre dos
// miembros de un viaje. No modifica los Gastos existentes: el saldo final
// de cada persona se calcula combinando Gastos + Settlements.
model Settlement {
  id          Int      @id @default(autoincrement())
  monto       Float
  pagadorId   Int
  receptorId  Int
  viajeId     Int
  pagador     User     @relation("SettlementsPagador", fields: [pagadorId], references: [id])
  receptor    User     @relation("SettlementsReceptor", fields: [receptorId], references: [id])
  viaje       Viaje    @relation(fields: [viajeId], references: [id])
  creadoEn    DateTime @default(now())
}

// Chat 1 a 1 entre dos usuarios, independiente de los viajes. Se crea al
// "invitar" a alguien por email (misma lógica que agregar un miembro a un
// viaje: se busca el usuario existente por email y se crea el vínculo
// directamente, sin un paso extra de aceptar/rechazar).
model Chat {
  id            Int                  @id @default(autoincrement())
  usuarioAId    Int
  usuarioBId    Int
  usuarioA      User                 @relation("ChatUsuarioA", fields: [usuarioAId], references: [id])
  usuarioB      User                 @relation("ChatUsuarioB", fields: [usuarioBId], references: [id])
  mensajes      MensajeChatPrivado[]
  // Marca temporal de la última vez que cada usuario abrió/leyó el chat.
  // Si el último mensaje es posterior a esto (y no lo mandó él mismo),
  // el chat figura como "no leído" para ese usuario.
  leidoPorAEn   DateTime?
  leidoPorBEn   DateTime?
  creadoEn      DateTime             @default(now())
}

model MensajeChatPrivado {
  id        Int      @id @default(autoincrement())
  contenido String
  chatId    Int
  usuarioId Int
  chat      Chat     @relation(fields: [chatId], references: [id])
  usuario   User     @relation(fields: [usuarioId], references: [id])
  enviadoEn DateTime @default(now())
}
